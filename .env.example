# Copy to .env and fill in. Never commit .env.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# n8n
N8N_BASE_URL=https://YOUR_N8N_ADDRESS
N8N_API_KEY=YOUR_N8N_API_KEY
# The workflow's "Run now" webhook URL, and the secret the dashboard sends with it
N8N_WEBHOOK_URL=https://YOUR_N8N_ADDRESS/webhook/YOUR_WEBHOOK_PATH
N8N_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Telegram: a bot made only for this project
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
